generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PAYER
  MERCHANT
}

enum PaymentStatus {
  CREATED
  PROCESSING
  CAPTURED
  FAILED
  REFUNDED
}

enum LedgerType {
  DEBIT
  CREDIT
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

model User {
  id                       Int              @id @default(autoincrement())
  email                    String           @unique
  name                     String
  role                     Role             @default(PAYER)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  passwordHash             String
  wallet                   Wallet?
  merchantProfile          MerchantProfile?
  paymentIntentsAsMerchant PaymentIntent[]  @relation("MerchantPaymentIntents")
  paymentIntentsAsPayer    PaymentIntent[]  @relation("PayerPaymentIntents")
}

model Wallet {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique
  balance       Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ledgerEntries LedgerEntry[]

  user User @relation(fields: [userId], references: [id])
}

model MerchantProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  businessName  String
  webhookUrl    String?
  webhookSecret String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PaymentIntent {
  id              String           @id @default(uuid())
  merchantId      Int
  payerId         Int?
  amountPaise     Int
  status          PaymentStatus    @default(CREATED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ledgerEntries   LedgerEntry[]
  idempotencyKeys IdempotencyKey[]
  webhookEvents   WebhookEvent[]

  merchant User  @relation("MerchantPaymentIntents", fields: [merchantId], references: [id])
  payer    User? @relation("PayerPaymentIntents", fields: [payerId], references: [id])
}

model LedgerEntry {
  id              Int        @id @default(autoincrement())
  paymentIntentId String
  walletId        Int
  type            LedgerType
  amountPaise     Int
  reason          String
  createdAt       DateTime   @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  wallet        Wallet        @relation(fields: [walletId], references: [id])

  @@index([paymentIntentId])
  @@index([walletId])
}

model IdempotencyKey {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  requestHash     String
  paymentIntentId String
  status          IdempotencyStatus @default(IN_PROGRESS)
  responseBody    String?
  responseStatus  Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id])

  @@index([paymentIntentId])
}

model WebhookEvent {
  id              Int           @id @default(autoincrement())
  paymentIntentId String
  type            String
  payload         Json
  status          WebhookStatus @default(PENDING)
  attempts        Int           @default(0)
  lastAttemptAt   DateTime?
  createdAt       DateTime      @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id])

  @@index([paymentIntentId])
  @@index([status])
}